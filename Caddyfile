fahmykamal.site {
	@index path /index.html
	redir @index / permanent

	root * /site
	file_server
}

www.fahmykamal.site {
	redir https://fahmykamal.site{uri} permanent
}

short.fahmykamal.site {
	reverse_proxy host.docker.internal:5076
}

